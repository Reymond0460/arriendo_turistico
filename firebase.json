{
  "hosting": {
    "public": ".",
    "ignore": [
      "docs/**",
      "package.json",
      "package-lock.json",
      "tailwind.config.js",
      "css/tailwind.src.css",
      "README.md",
      "servir.bat",
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/desktop.ini",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "**/*.@(html|css|js)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
